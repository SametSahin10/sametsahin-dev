---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import mePhoto from "../assets/me.jpg";
import resumeFile from "../assets/resume.pdf?url";
import { getFeaturedEntries, getSortedCollection } from "../lib/content";

const [featuredEntries, latestTech, latestLife] = await Promise.all([
  getFeaturedEntries(),
  getSortedCollection("tech"),
  getSortedCollection("life"),
]);

const hasFeaturedEntries = featuredEntries.length > 0;
const hasTechEntries = latestTech.length > 0;
const hasLifeEntries = latestLife.length > 0;
---

<BaseLayout
  title="sametsahin.dev"
  description="A privacy-first digital garden and portfolio for engineering writing, personal essays, and life updates."
>
  <section class="grid gap-12 pb-24 pt-14 md:grid-cols-[minmax(0,1.1fr)_minmax(18rem,0.9fr)] md:items-center md:gap-16">
    <div class="max-w-3xl text-left">
      <h1 class="font-display text-5xl leading-[1.02] text-[var(--text)] md:text-6xl">
        Hello, I'm Samet.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--muted-strong)]">
        This is my personal space for writing about engineering, side projects, travel, music,
        and the things I want to remember.
      </p>
      <div class="mt-8 space-y-3 text-sm">
        <div class="flex flex-wrap justify-center gap-3 md:justify-start">
          <a
            class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-[var(--muted-strong)] transition hover:bg-[var(--surface-strong)] hover:text-[var(--text)]"
            href="https://github.com/SametSahin10"
            target="_blank"
            rel="noreferrer"
            data-analytics-location="home_hero"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.5 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.2-3.37-1.2-.46-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .08 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.13.63-1.39-2.22-.26-4.56-1.14-4.56-5.09 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.52.36 1.91-1.32 2.75-1.05 2.75-1.05.55 1.4.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.96-2.34 4.82-4.57 5.08.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .28.18.61.69.5A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"/>
            </svg>
            GitHub
          </a>
          <a
            class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-[var(--muted-strong)] transition hover:bg-[var(--surface-strong)] hover:text-[var(--text)]"
            href="https://x.com/SahinSamet10"
            target="_blank"
            rel="noreferrer"
            data-analytics-location="home_hero"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.26l-4.9-6.9L6 22H2.9l7.24-8.27L.8 2h6.36l4.43 6.26L18.9 2Zm-1.1 18h1.73L6.22 3.9H4.36L17.8 20Z"/>
            </svg>
            Twitter
          </a>
          <a
            class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-[var(--muted-strong)] transition hover:bg-[var(--surface-strong)] hover:text-[var(--text)]"
            href="https://linkedin.com/in/sahinsamet10"
            target="_blank"
            rel="noreferrer"
            data-analytics-location="home_hero"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 3C4.17 3 3.3 3.9 3.3 5s.87 2 1.95 2c1.07 0 1.94-.9 1.94-2S6.32 3 5.25 3ZM20.7 12.87c0-3.45-1.8-5.05-4.2-5.05-1.94 0-2.8 1.08-3.29 1.85V8.5H9.83c.04.78 0 11.5 0 11.5h3.38v-6.42c0-.34.02-.68.12-.92.27-.68.87-1.39 1.89-1.39 1.33 0 1.86 1.05 1.86 2.58V20h3.38v-7.13Z"/>
            </svg>
            LinkedIn
          </a>
        </div>
        <div class="flex flex-wrap justify-center gap-3 md:justify-start">
          <a
            class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-[var(--muted-strong)] transition hover:bg-[var(--surface-strong)] hover:text-[var(--text)]"
            href={resumeFile}
            target="_blank"
            rel="noreferrer"
            data-analytics-location="home_hero"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/>
              <path d="M14 3v5h5"/>
              <path d="M9 13h6M9 17h6M9 9h2"/>
            </svg>
            Resume
          </a>
          <a
            class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-[var(--muted-strong)] transition hover:bg-[var(--surface-strong)] hover:text-[var(--text)]"
            href="mailto:a.sahin.ual@gmail.com"
            data-analytics-location="home_hero"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M4 6h16v12H4z"></path>
              <path d="M4 8l8 6 8-6"></path>
            </svg>
            Email
          </a>
        </div>
      </div>
    </div>
    <aside class="flex justify-center md:justify-end">
      <div class="hero-orb relative flex h-[20rem] w-[20rem] items-center justify-center overflow-hidden rounded-full bg-[var(--surface)] shadow-[0_30px_80px_rgba(36,28,20,0.08)] md:h-[24rem] md:w-[24rem]">
        <div class="absolute inset-0 overflow-hidden rounded-full">
          <Image
            src={mePhoto}
            alt="Portrait of Samet Şahin"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </aside>
  </section>

  <section class="grid gap-8 pb-24 md:grid-cols-3">
    <article class="rounded-[2rem] border border-[var(--border)] bg-[var(--surface)] p-6">
      <p class="text-sm uppercase tracking-[0.24em] text-[var(--muted)]">Mobile</p>
      <h2 class="mt-3 font-display text-3xl text-[var(--text)]">Mobile and product delivery</h2>
      <p class="mt-4 text-sm leading-7 text-[var(--muted-strong)]">
        Production apps across iOS, Android, and web with clean architecture, payments, and offline flows.
      </p>
    </article>
    <article class="rounded-[2rem] border border-[var(--border)] bg-[var(--surface)] p-6">
      <p class="text-sm uppercase tracking-[0.24em] text-[var(--muted)]">Backend</p>
      <h2 class="mt-3 font-display text-3xl text-[var(--text)]">Node systems at scale</h2>
      <p class="mt-4 text-sm leading-7 text-[var(--muted-strong)]">
        Microservices, cloud functions, and service design built for reliability and high throughput.
      </p>
    </article>
    <article class="rounded-[2rem] border border-[var(--border)] bg-[var(--surface)] p-6">
      <p class="text-sm uppercase tracking-[0.24em] text-[var(--muted)]">Workflow</p>
      <h2 class="mt-3 font-display text-3xl text-[var(--text)]">AI-assisted engineering</h2>
      <p class="mt-4 text-sm leading-7 text-[var(--muted-strong)]">
        Testing, iteration, and delivery workflows that help move faster without making the codebase worse.
      </p>
    </article>
  </section>

  {hasFeaturedEntries && (
    <section class="grid gap-8 pb-24 md:grid-cols-2">
      {featuredEntries.map((entry) => <PostCard entry={entry} />)}
    </section>
  )}

  {(hasTechEntries || hasLifeEntries) && (
    <section class:list={[
      "grid gap-10 pb-10",
      hasTechEntries && hasLifeEntries ? "md:grid-cols-2" : "md:grid-cols-1",
    ]}>
      {hasTechEntries && (
        <div class="rounded-[2.5rem] border border-[var(--border)] bg-[var(--surface)] p-6 md:p-8">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="text-sm uppercase tracking-[0.24em] text-[var(--muted)]">Tech</p>
              <h2 class="mt-3 font-display text-3xl text-[var(--text)]">Recent tech writing</h2>
            </div>
            <a
              class="text-sm text-[var(--muted-strong)] underline decoration-[var(--border-strong)] underline-offset-4"
              href="/tech/"
              data-analytics-event="navigation_click"
              data-analytics-label="Browse tech"
              data-analytics-location="home_recent_tech"
            >
              Browse
            </a>
          </div>
          <div class="mt-8 space-y-5">
            {latestTech.slice(0, 3).map((entry) => <PostCard entry={entry} variant="compact" />)}
          </div>
        </div>
      )}
      {hasLifeEntries && (
        <div class="rounded-[2.5rem] border border-[var(--border)] bg-[var(--surface)] p-6 md:p-8">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="text-sm uppercase tracking-[0.24em] text-[var(--muted)]">Life</p>
              <h2 class="mt-3 font-display text-3xl text-[var(--text)]">Recent life notes</h2>
            </div>
            <a
              class="text-sm text-[var(--muted-strong)] underline decoration-[var(--border-strong)] underline-offset-4"
              href="/life/"
              data-analytics-event="navigation_click"
              data-analytics-label="Browse life"
              data-analytics-location="home_recent_life"
            >
              Browse
            </a>
          </div>
          <div class="mt-8 space-y-5">
            {latestLife.slice(0, 3).map((entry) => <PostCard entry={entry} variant="compact" />)}
          </div>
        </div>
      )}
    </section>
  )}

</BaseLayout>
