---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getSortedCollection } from "../../lib/content";

const entries = await getSortedCollection("life");
---

<BaseLayout
  title="Life | sametsahin.dev"
  description="Personal essays and updates on travel, classical guitar, sim racing, and the rituals around a good life."
>
  <section class="max-w-3xl pb-12 pt-8">
    <p class="text-sm uppercase tracking-[0.28em] text-[var(--muted)]">Collection / life</p>
    <h1 class="mt-5 font-display text-4xl leading-tight text-[var(--text)] md:text-5xl">
      Travel, practice, and personal notes worth keeping.
    </h1>
    <p class="mt-6 text-lg leading-8 text-[var(--muted-strong)]">
      Travel journals, guitar practice, and slower essays. More notebook than feed.
    </p>
  </section>

  <section class="grid gap-6 pb-12">
    {entries.map((entry) => <PostCard entry={entry} />)}
  </section>
</BaseLayout>
