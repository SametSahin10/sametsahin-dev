---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getSortedCollection } from "../../lib/content";

const entries = await getSortedCollection("tech");
---

<BaseLayout
  title="Tech | sametsahin.dev"
  description="Technical writing about local LLM hosting, mobile architecture, AI integration workflows, and product systems."
>
  <section class="max-w-3xl pb-12 pt-8">
    <p class="text-sm uppercase tracking-[0.28em] text-[var(--muted)]">Collection / tech</p>
    <h1 class="mt-5 font-display text-4xl leading-tight text-[var(--text)] md:text-5xl">
      Technical writing on systems, mobile architecture, and AI workflows.
    </h1>
    <p class="mt-6 text-lg leading-8 text-[var(--muted-strong)]">
      Notes from shipping software: backend systems, product architecture, local AI tooling, and mobile delivery.
    </p>
  </section>

  <section class="grid gap-6 pb-12">
    {entries.map((entry) => <PostCard entry={entry} />)}
  </section>
</BaseLayout>
