---
import "@fontsource-variable/fraunces";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import resumeFile from "../assets/resume.pdf?url";

type Props = {
  title: string;
  description?: string;
};

const {
  title,
  description = "A privacy-first digital garden for engineering notes, personal essays, and life updates.",
} = Astro.props;
const currentYear = new Date().getFullYear();
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const isAnalyticsEnabled = Boolean(gaMeasurementId);

const navItems = [
  { href: "/", label: "Index" },
  { href: "/tech/", label: "Tech" },
  { href: "/life/", label: "Life" },
];

const socialLinks = [
  { href: "https://github.com/SametSahin10", label: "GitHub" },
  { href: "https://x.com/SahinSamet10", label: "Twitter" },
  { href: "https://linkedin.com/in/sahinsamet10", label: "LinkedIn" },
  { href: resumeFile, label: "Resume" },
];

const isActivePath = (href: string) =>
  href === "/" ? Astro.url.pathname === "/" : Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {isAnalyticsEnabled && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag() {
            window.dataLayer.push(arguments);
          };
          window.gtag("js", new Date());
          window.gtag("config", gaMeasurementId, {
            anonymize_ip: true,
            page_title: document.title,
            page_path: window.location.pathname,
          });
        </script>
      </>
    )}
    <script is:inline>
      window.trackSiteEvent = function trackSiteEvent(eventName, parameters = {}) {
        if (typeof window.gtag !== "function") return;

        window.gtag("event", eventName, {
          page_path: window.location.pathname,
          ...parameters,
        });
      };
    </script>
  </head>
  <body class="min-h-screen bg-[var(--page)] text-[var(--text)] antialiased">
    <div class="fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute left-[-8rem] top-[-6rem] h-72 w-72 rounded-full bg-[var(--accent-soft)] blur-3xl"></div>
      <div class="absolute bottom-[-10rem] right-[-6rem] h-80 w-80 rounded-full bg-[var(--accent-softer)] blur-3xl"></div>
      <div class="grain"></div>
    </div>

    <header class="mx-auto flex w-full max-w-6xl items-center justify-between gap-6 px-6 py-8 md:px-10">
      <a class="font-display text-lg tracking-[0.08em] text-[var(--text)] md:text-xl" href="/">
        sametsahin.dev
      </a>
      <div class="flex items-center gap-3 md:gap-4">
        <nav class="hidden md:block" aria-label="Primary">
          <ul class="flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] p-2">
            {navItems.map((item) => (
              <li>
                <a
                  class:list={[
                    "rounded-full px-4 py-2 text-sm transition hover:bg-[var(--surface-strong)]",
                    isActivePath(item.href)
                      ? "bg-[var(--nav-active)] text-[var(--text)] shadow-[inset_0_0_0_1px_var(--nav-active-border)]"
                      : "text-[var(--muted-strong)]",
                  ]}
                  href={item.href}
                  data-analytics-event="navigation_click"
                  data-analytics-label={item.label}
                  data-analytics-location="desktop_header"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <ThemeToggle />
        <button
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[var(--border-strong)] bg-[var(--surface)] text-[var(--text)] transition hover:bg-[var(--surface-strong)] md:hidden"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-drawer"
          data-drawer-open
          data-analytics-event="mobile_menu_toggle"
          data-analytics-label="open"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
      </div>
    </header>

    <div class="pointer-events-none fixed inset-0 z-40 bg-black/20 opacity-0 transition md:hidden" data-drawer-backdrop></div>
    <aside
      id="mobile-drawer"
      class="fixed right-0 top-0 z-50 flex h-full w-[18rem] translate-x-full flex-col border-l border-[var(--border)] bg-[var(--page)] px-6 py-6 shadow-[0_20px_60px_rgba(0,0,0,0.12)] transition-transform duration-300 md:hidden"
      aria-hidden="true"
      data-drawer
    >
      <div class="flex items-center justify-between">
        <p class="font-display text-xl text-[var(--text)]">Menu</p>
        <button
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[var(--border-strong)] bg-[var(--surface)] text-[var(--text)] transition hover:bg-[var(--surface-strong)]"
          type="button"
          aria-label="Close navigation menu"
          data-drawer-close
          data-analytics-event="mobile_menu_toggle"
          data-analytics-label="close"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
      <nav class="mt-8" aria-label="Mobile primary">
        <ul class="space-y-3">
          {navItems.map((item) => (
            <li>
              <a
                class:list={[
                  "block rounded-[1.2rem] border px-4 py-3 text-base transition",
                  isActivePath(item.href)
                    ? "border-[var(--nav-active-border)] bg-[var(--nav-active)] text-[var(--text)]"
                    : "border-[var(--border)] bg-[var(--surface)] text-[var(--muted-strong)] hover:bg-[var(--surface-strong)] hover:text-[var(--text)]",
                ]}
                href={item.href}
                data-drawer-link
                data-analytics-event="navigation_click"
                data-analytics-label={item.label}
                data-analytics-location="mobile_drawer"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="mt-auto pt-8">
        <p class="text-xs uppercase tracking-[0.24em] text-[var(--muted)]">Elsewhere</p>
        <div class="mt-4 flex flex-wrap gap-3 text-sm">
          {socialLinks.map((link) => (
            <a
              class="rounded-full border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-[var(--muted-strong)] transition hover:bg-[var(--surface-strong)] hover:text-[var(--text)]"
              href={link.href}
              target="_blank"
              rel="noreferrer"
              data-analytics-location="mobile_drawer"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </aside>

    <main class="mx-auto w-full max-w-6xl px-6 pb-20 md:px-10">
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-6xl px-6 pb-12 md:px-10">
      <div class="rounded-[2rem] border border-[var(--border)] bg-[var(--surface)] px-6 py-6 md:px-8">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="font-display text-2xl text-[var(--text)]">sametsahin.dev</p>
            <p class="mt-2 text-sm leading-7 text-[var(--muted-strong)]">
              Notes on engineering, projects, travel, music, and the things worth keeping.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 text-sm">
            <a
              class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-4 py-2 text-[var(--muted-strong)] transition hover:bg-[var(--surface-strong)] hover:text-[var(--text)]"
              href="https://github.com/SametSahin10"
              target="_blank"
              rel="noreferrer"
              data-analytics-location="footer"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.5 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.2-3.37-1.2-.46-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .08 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.13.63-1.39-2.22-.26-4.56-1.14-4.56-5.09 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.52.36 1.91-1.32 2.75-1.05 2.75-1.05.55 1.4.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.96-2.34 4.82-4.57 5.08.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .28.18.61.69.5A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"/>
              </svg>
              GitHub
            </a>
            <a
              class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-4 py-2 text-[var(--muted-strong)] transition hover:bg-[var(--surface-strong)] hover:text-[var(--text)]"
              href="https://x.com/SahinSamet10"
              target="_blank"
              rel="noreferrer"
              data-analytics-location="footer"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.26l-4.9-6.9L6 22H2.9l7.24-8.27L.8 2h6.36l4.43 6.26L18.9 2Zm-1.1 18h1.73L6.22 3.9H4.36L17.8 20Z"/>
              </svg>
              Twitter
            </a>
            <a
              class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-4 py-2 text-[var(--muted-strong)] transition hover:bg-[var(--surface-strong)] hover:text-[var(--text)]"
              href="https://linkedin.com/in/sahinsamet10"
              target="_blank"
              rel="noreferrer"
              data-analytics-location="footer"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 3C4.17 3 3.3 3.9 3.3 5s.87 2 1.95 2c1.07 0 1.94-.9 1.94-2S6.32 3 5.25 3ZM20.7 12.87c0-3.45-1.8-5.05-4.2-5.05-1.94 0-2.8 1.08-3.29 1.85V8.5H9.83c.04.78 0 11.5 0 11.5h3.38v-6.42c0-.34.02-.68.12-.92.27-.68.87-1.39 1.89-1.39 1.33 0 1.86 1.05 1.86 2.58V20h3.38v-7.13Z"/>
              </svg>
              LinkedIn
            </a>
          <a
            class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-4 py-2 text-[var(--muted-strong)] transition hover:bg-[var(--surface-strong)] hover:text-[var(--text)]"
            href={resumeFile}
            target="_blank"
            rel="noreferrer"
            data-analytics-location="footer"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/>
                <path d="M14 3v5h5"/>
                <path d="M9 13h6M9 17h6M9 9h2"/>
            </svg>
            Resume
          </a>
          <a
            class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-4 py-2 text-[var(--muted-strong)] transition hover:bg-[var(--surface-strong)] hover:text-[var(--text)]"
            href="mailto:a.sahin.ual@gmail.com"
            data-analytics-location="footer"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M4 6h16v12H4z"/>
              <path d="M4 8l8 6 8-6"/>
            </svg>
            Email
          </a>
        </div>
        </div>
        <div class="mt-6 border-t border-[var(--border)] pt-4 text-sm text-[var(--muted)]">
          &copy; {currentYear} Samet Şahin. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
  <script is:inline>
    const drawer = document.querySelector("[data-drawer]");
    const backdrop = document.querySelector("[data-drawer-backdrop]");
    const openButton = document.querySelector("[data-drawer-open]");
    const closeButton = document.querySelector("[data-drawer-close]");
    const drawerLinks = document.querySelectorAll("[data-drawer-link]");

    const setDrawerState = (isOpen) => {
      if (!drawer || !backdrop || !openButton) return;
      drawer.classList.toggle("translate-x-full", !isOpen);
      backdrop.classList.toggle("pointer-events-none", !isOpen);
      backdrop.classList.toggle("opacity-0", !isOpen);
      drawer.setAttribute("aria-hidden", String(!isOpen));
      openButton.setAttribute("aria-expanded", String(isOpen));
      document.body.classList.toggle("overflow-hidden", isOpen);
    };

    openButton?.addEventListener("click", () => setDrawerState(true));
    closeButton?.addEventListener("click", () => setDrawerState(false));
    backdrop?.addEventListener("click", () => setDrawerState(false));
    drawerLinks.forEach((link) => link.addEventListener("click", () => setDrawerState(false)));
    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setDrawerState(false);
    });
  </script>
  <script is:inline>
    const getLinkDomain = (href) => {
      try {
        return new URL(href, window.location.href).hostname;
      } catch {
        return "";
      }
    };

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const link = target?.closest("a[href]");
      const explicitTarget = target?.closest("[data-analytics-event]");

      if (explicitTarget) {
        window.trackSiteEvent?.(explicitTarget.dataset.analyticsEvent, {
          event_label: explicitTarget.dataset.analyticsLabel || explicitTarget.textContent?.trim() || undefined,
          event_location: explicitTarget.dataset.analyticsLocation,
          destination_url: explicitTarget instanceof HTMLAnchorElement ? explicitTarget.href : undefined,
        });
      }

      if (!link) return;

      const linkText = link.textContent?.trim();
      const eventLocation = link.dataset.analyticsLocation;

      if (link.href.startsWith("mailto:")) {
        window.trackSiteEvent?.("email_click", {
          event_label: linkText,
          event_location: eventLocation,
          email_domain: link.href.split("@").at(-1),
        });
        return;
      }

      if (link.pathname.endsWith(".pdf")) {
        window.trackSiteEvent?.("resume_open", {
          event_label: linkText || "Resume",
          event_location: eventLocation,
          file_name: link.pathname.split("/").at(-1),
        });
        return;
      }

      if (link.origin !== window.location.origin) {
        window.trackSiteEvent?.("outbound_link_click", {
          event_label: linkText,
          event_location: eventLocation,
          link_domain: getLinkDomain(link.href),
          link_url: link.href,
        });
      }
    });
  </script>
</html>
